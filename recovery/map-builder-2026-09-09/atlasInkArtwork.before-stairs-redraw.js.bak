// Use the same subtle contour variation on every layer of a symbol, including
// solid shadow borders and carved highlights, so the drawing stays coherent.
Object.entries(INK_ARTWORK).forEach(([name, layers], index) => {
  INK_ARTWORK[name] = layers.map(layer => ({ ...layer, d: organicInkPath(layer.d, index * 1.71) }))
})
