import { organicInkPath } from './atlasOrganicInk.js'

// Editable pen-and-brush layers. Solid ink and paper cutouts are intentional:
// these are miniature illustrations, not outline icons. Coordinates are -40…40.
const illustration = (silhouette, shadow, detail = '', cuts = '', ground = '') => [
  { d: silhouette, fill: 'paper', stroke: 'ink', width: 1.35 },
  { d: shadow, fill: 'ink', stroke: 'none' },
  { d: detail, fill: 'none', stroke: 'ink', width: .7 },
  { d: cuts, fill: 'none', stroke: 'paper', width: .8 },
  { d: ground, fill: 'none', stroke: 'ink', width: .65 },
].filter(layer => layer.d)

