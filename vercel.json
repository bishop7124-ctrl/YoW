{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "yourownworld.co.uk" }
      ],
      "destination": "https://www.yourownworld.co.uk/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/beta-disclaimer/", "destination": "/beta-disclaimer/index.html" },
    { "source": "/founders/", "destination": "/founders/index.html" },
    { "source": "/founders/:slug/", "destination": "/founders/:slug/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/ai-overview/", "destination": "/ai-overview/index.html" },
    { "source": "/worldbuilding-software/", "destination": "/worldbuilding-software/index.html" },
    { "source": "/novel-writing-software/", "destination": "/novel-writing-software/index.html" },
    { "source": "/dnd-campaign-manager/", "destination": "/dnd-campaign-manager/index.html" },
    { "source": "/story-planning-software/", "destination": "/story-planning-software/index.html" },
    { "source": "/timeline-tool-for-writers/", "destination": "/timeline-tool-for-writers/index.html" },
    { "source": "/family-tree-builder/", "destination": "/family-tree-builder/index.html" },
    { "source": "/map-builder-for-writers/", "destination": "/map-builder-for-writers/index.html" },
    { "source": "/lore-management/", "destination": "/lore-management/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html"  }
  ],
  "crons": [
    { "path": "/api/send-reengagement-emails", "schedule": "0 14 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
