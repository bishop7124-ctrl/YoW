    function item(id, title, route, steps, expected, evidence, tags) {
      return { id, title, route, steps, expected, evidence, tags };
    }

    let state = loadJson(STORE_KEY, {});
    let collapsed = loadJson(COLLAPSE_KEY, {});
    let currentFilter = 'all';

    function loadJson(key, fallback) {
      try { return JSON.parse(localStorage.getItem(key)) || fallback; }
      catch { return fallback; }
    }

    function saveState() { localStorage.setItem(STORE_KEY, JSON.stringify(state)); }
    function saveCollapsed() { localStorage.setItem(COLLAPSE_KEY, JSON.stringify(collapsed)); }
    function getEntry(id) { return state[id] || { status: '', note: '', evidence: '' }; }

    function render() {
      const root = document.getElementById('sections');
      root.innerHTML = SECTIONS.map(section => {
        const rows = section.items.map(renderItem).join('');
        const done = section.items.filter(i => ['pass', 'na'].includes(getEntry(i.id).status)).length;
        const collapsedClass = collapsed[section.id] ? ' collapsed' : '';
        return `<section id="${section.id}" class="section${collapsedClass}">
          <button type="button" class="section-header" onclick="toggleSection('${section.id}')">
            <h2>${esc(section.title)}</h2>
            <span class="section-count">${done} / ${section.items.length}</span>
            <span class="chev">▾</span>
          </button>
          <div class="items">${rows}</div>
        </section>`;
      }).join('');
      updateStats();
      applyFilters();
    }

    function renderItem(entry) {
      const saved = getEntry(entry.id);
      const haystack = [
        entry.title, entry.route, entry.expected, entry.evidence,
        entry.steps.join(' '), entry.tags.join(' '), saved.note, saved.evidence
      ].join(' ').toLowerCase();
      return `<article class="item" id="item-${entry.id}" data-id="${entry.id}" data-status="${saved.status || 'open'}" data-search="${escAttr(haystack)}">
        <div class="item-main">
          <div>
            <p class="item-title">${esc(entry.title)}</p>
            <p class="route"><b>Route:</b> ${esc(entry.route)}</p>
            <ol class="steps">${entry.steps.map(step => `<li>${esc(step)}</li>`).join('')}</ol>
            <p class="expected"><b>Expected:</b> ${esc(entry.expected)}</p>
            <p class="evidence"><b>Evidence to capture:</b> ${esc(entry.evidence)}</p>
            <div class="tag-row">${entry.tags.map(tag => `<span class="tag">${esc(tag)}</span>`).join('')}</div>
          </div>
          <div class="controls">
            <div class="status-grid">${STATUSES.map(statusButton(entry.id, saved.status)).join('')}</div>
            <label class="field-label" for="evidence-${entry.id}">Evidence / artifact links</label>
            <input id="evidence-${entry.id}" class="meta-input" value="${escAttr(saved.evidence || '')}" oninput="updateField('${entry.id}', 'evidence', this.value)" placeholder="Screenshots, export filenames, account aliases, dashboard IDs...">
            <label class="field-label" for="note-${entry.id}">Notes / decisions / reproduction details</label>
            <textarea id="note-${entry.id}" oninput="updateField('${entry.id}', 'note', this.value)" placeholder="What did you decide? What happened? What is still blocked?">${esc(saved.note || '')}</textarea>
          </div>
        </div>
      </article>`;
    }

    function statusButton(id, current) {
      return status => `<label class="status ${status} ${current === status ? 'active' : ''}">
        <input type="checkbox" ${current === status ? 'checked' : ''} onchange="setStatus('${id}', '${status}', this.checked)">
        ${STATUS_LABELS[status]}
      </label>`;
    }

    function setStatus(id, status, checked) {
      state[id] = { ...getEntry(id), status: checked ? status : '' };
      saveState();
      render();
    }

    function updateField(id, field, value) {
      state[id] = { ...getEntry(id), [field]: value };
      saveState();
      const row = document.getElementById(`item-${id}`);
      if (row) {
        row.dataset.search = [row.innerText, getEntry(id).note, getEntry(id).evidence].join(' ').toLowerCase();
      }
      updateStats();
      applyFilters();
    }

    function updateStats() {
      const items = SECTIONS.flatMap(s => s.items);
      const counts = { pass: 0, progress: 0, fail: 0, blocked: 0, retest: 0, na: 0, open: 0 };
      items.forEach(i => {
        const status = getEntry(i.id).status || 'open';
        counts[status] = (counts[status] || 0) + 1;
      });
      const complete = Math.round(((counts.pass + counts.na) / items.length) * 100) || 0;
      document.getElementById('stat-pass').textContent = counts.pass;
      document.getElementById('stat-open').textContent = counts.open;
      document.getElementById('stat-progress').textContent = counts.progress;
      document.getElementById('stat-fail').textContent = counts.fail;
      document.getElementById('stat-blocked').textContent = counts.blocked;
      document.getElementById('stat-complete').textContent = `${complete}%`;
    }

    function setFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll('.filter').forEach(btn => btn.classList.remove('active'));
      document.getElementById(`filter-${filter}`).classList.add('active');
      applyFilters();
    }

    function applyFilters() {
      const query = document.getElementById('search').value.trim().toLowerCase();
      document.querySelectorAll('.item').forEach(row => {
        const status = row.dataset.status || 'open';
        const noted = !!(getEntry(row.dataset.id).note || getEntry(row.dataset.id).evidence || '').trim();
        let show = true;
        if (query && !row.dataset.search.includes(query)) show = false;
        if (currentFilter === 'open' && status !== 'open') show = false;
        if (['progress', 'fail', 'blocked', 'retest'].includes(currentFilter) && status !== currentFilter) show = false;
        if (currentFilter === 'notes' && !noted) show = false;
        row.classList.toggle('hidden', !show);
      });
    }

    function toggleSection(id) {
      collapsed[id] = !collapsed[id];
      saveCollapsed();
      document.getElementById(id).classList.toggle('collapsed', collapsed[id]);
    }

    function collapseAll() {
      SECTIONS.forEach(s => collapsed[s.id] = true);
      saveCollapsed();
      render();
    }

    function expandAll() {
      SECTIONS.forEach(s => collapsed[s.id] = false);
      saveCollapsed();
      render();
    }

    function resetAll() {
      if (!confirm('Reset all statuses, notes, and evidence for this owner launch checklist?')) return;
      state = {};
      saveState();
      render();
    }

    function openExport() { document.getElementById('exportModal').classList.add('open'); }
    function closeExport() { document.getElementById('exportModal').classList.remove('open'); }
    document.getElementById('exportModal').addEventListener('click', event => {
      if (event.target.id === 'exportModal') closeExport();
    });

    function collectRows() {
      const includeOpen = document.getElementById('exportAll').checked;
      const rows = [];
      SECTIONS.forEach(section => {
        section.items.forEach(entry => {
          const saved = getEntry(entry.id);
          const hasEvidence = !!(saved.note || saved.evidence || saved.status);
          if (!includeOpen && !hasEvidence) return;
          rows.push({
            section: section.title,
            id: entry.id,
            title: entry.title,
            route: entry.route,
            steps: entry.steps,
            expected: entry.expected,
            evidencePrompt: entry.evidence,
            tags: entry.tags,
            status: saved.status || 'open',
            evidence: saved.evidence || '',
            note: saved.note || ''
          });
        });
      });
      return rows;
    }

    function runExport() {
      const rows = collectRows();
      const format = document.querySelector('input[name="format"]:checked').value;
      const stamp = new Date().toISOString().slice(0,16).replace('T', '_').replace(':', '-');
      if (format === 'json') {
        download(`yow-owner-launch-checklist-${stamp}.json`, JSON.stringify(rows, null, 2), 'application/json');
      } else if (format === 'csv') {
        const cells = ['Section', 'ID', 'Title', 'Status', 'Route', 'Steps', 'Expected', 'Evidence Prompt', 'Evidence', 'Note', 'Tags'];
        const lines = [cells.join(',')].concat(rows.map(r => [
          csv(r.section), csv(r.id), csv(r.title), csv(r.status), csv(r.route), csv(r.steps.join(' | ')),
          csv(r.expected), csv(r.evidencePrompt), csv(r.evidence), csv(r.note), csv(r.tags.join(' | '))
        ].join(',')));
        download(`yow-owner-launch-checklist-${stamp}.csv`, lines.join('\n'), 'text/csv');
      } else if (format === 'html') {
        download(`yow-owner-launch-checklist-${stamp}.html`, reportHtml(rows), 'text/html');
      } else {
        download(`yow-owner-launch-checklist-${stamp}.md`, reportMarkdown(rows), 'text/markdown');
      }
      closeExport();
    }

    function reportMarkdown(rows) {
      let md = `# YOW Owner Launch Checklist Evidence\n\nGenerated: ${new Date().toLocaleString()}\n\n`;
      let last = '';
      rows.forEach(row => {
        if (row.section !== last) {
          md += `\n## ${row.section}\n\n`;
          last = row.section;
        }
        md += `### ${row.title}\n\n`;
        md += `- Status: ${STATUS_LABELS[row.status] || 'Open'}\n`;
        md += `- Route: ${row.route}\n`;
        md += `- Expected: ${row.expected}\n`;
        md += `- Evidence Prompt: ${row.evidencePrompt}\n`;
        md += `- Tags: ${row.tags.join(', ')}\n`;
        if (row.evidence.trim()) md += `- Evidence: ${row.evidence.trim()}\n`;
        if (row.note.trim()) md += `- Notes: ${row.note.trim()}\n`;
        md += '\nSteps:\n';
        row.steps.forEach((step, index) => { md += `${index + 1}. ${step}\n`; });
        md += '\n';
      });
      return md;
    }

    function reportHtml(rows) {
      const body = rows.map(row => `<section>
        <h2>${esc(row.title)}</h2>
        <p><b>Status:</b> ${esc(STATUS_LABELS[row.status] || 'Open')}</p>
        <p><b>Section:</b> ${esc(row.section)}</p>
        <p><b>Route:</b> ${esc(row.route)}</p>
        <ol>${row.steps.map(step => `<li>${esc(step)}</li>`).join('')}</ol>
        <p><b>Expected:</b> ${esc(row.expected)}</p>
        <p><b>Evidence prompt:</b> ${esc(row.evidencePrompt)}</p>
        <p><b>Tags:</b> ${esc(row.tags.join(', '))}</p>
        ${row.evidence ? `<p><b>Evidence:</b> ${esc(row.evidence)}</p>` : ''}
        ${row.note ? `<p><b>Notes:</b> ${esc(row.note)}</p>` : ''}
      </section>`).join('');
      return `<!doctype html><html lang="en"><head><meta charset="utf-8"><title>YOW Owner Launch Checklist Evidence</title><style>
        body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;max-width:920px;margin:0 auto;padding:32px;color:#17202a;line-height:1.5}
        h1{color:#2f675b} section{border-top:1px solid #d8d1c7;padding:18px 0} h2{font-size:18px} p{margin:7px 0}
      </style></head><body><h1>YOW Owner Launch Checklist Evidence</h1><p>Generated: ${new Date().toLocaleString()}</p>${body}</body></html>`;
    }

    function csv(value) {
      return `"${String(value || '').replace(/"/g, '""')}"`;
    }

    function download(filename, content, mime) {
      const link = document.createElement('a');
      link.href = URL.createObjectURL(new Blob([content], { type: mime }));
      link.download = filename;
      link.click();
      setTimeout(() => URL.revokeObjectURL(link.href), 1000);
    }

    function esc(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function escAttr(value) {
      return esc(value).replace(/"/g, '&quot;');
    }

    render();
  </script>
</body>
</html>
