<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>YOW Owner Launch Checklist</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #f5f2ed;
      --panel: #ffffff;
      --panel-2: #faf8f4;
      --panel-3: #eee9df;
      --ink: #17202a;
      --muted: #637083;
      --line: #d8d1c7;
      --brand: #2f675b;
      --brand-2: #25584d;
      --pass: #3aa866;
      --fail: #c84848;
      --blocked: #b77512;
      --retest: #4268c7;
      --na: #8992a0;
      --progress: #7b55c7;
      --radius: 8px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 14px;
      line-height: 1.5;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(255, 255, 255, 0.96);
      border-bottom: 1px solid var(--line);
      padding: 14px 24px;
      display: grid;
      grid-template-columns: minmax(240px, 1fr) auto;
      gap: 16px;
      align-items: center;
      backdrop-filter: blur(10px);
    }

    h1, h2 { margin: 0; line-height: 1.2; letter-spacing: 0; }
    h1 { color: var(--brand); font-size: 22px; }
    h2 { font-size: 17px; }
    p { margin: 0; }
    code { background: var(--panel-3); border-radius: 4px; padding: 2px 5px; }
    a { color: var(--brand); font-weight: 750; }

    .subtitle {
      margin-top: 4px;
      color: var(--muted);
      font-size: 13px;
      max-width: 900px;
    }

    .header-actions,
    .toolbar-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
    }

    button {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      color: var(--ink);
      padding: 7px 12px;
      font: inherit;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
    }

    button:hover { border-color: var(--brand); }
    .primary { background: var(--brand); border-color: var(--brand); color: white; }
    .danger { background: #fff2f0; border-color: #e1a6a0; color: #96352d; }

    .wrap {
      max-width: 1180px;
      margin: 0 auto;
      padding: 20px 24px 48px;
    }

    .toolbar {
      position: sticky;
      top: 76px;
      z-index: 8;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 12px 0;
      display: grid;
      grid-template-columns: minmax(240px, 1fr) auto;
      gap: 12px;
      align-items: center;
    }

    .search {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      color: var(--ink);
      padding: 9px 12px;
      font: inherit;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .filter {
      padding: 6px 10px;
      border-radius: 999px;
      color: var(--muted);
    }

    .filter.active {
      color: white;
      background: var(--brand);
      border-color: var(--brand);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(6, minmax(120px, 1fr));
      gap: 10px;
      margin: 18px 0;
    }

    .stat {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      padding: 12px;
    }

    .stat strong {
      display: block;
      font-size: 24px;
      color: var(--brand);
      line-height: 1;
      margin-bottom: 7px;
    }

    .stat span {
      color: var(--muted);
      font-size: 12px;
    }

    .intro,
    .section {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      margin: 14px 0;
      overflow: hidden;
    }

    .intro { padding: 16px; }
    .intro p { margin-top: 8px; color: var(--muted); }
    .intro ol { margin: 12px 0 0 22px; padding: 0; }
    .intro li { margin: 5px 0; }

    .section-header {
      width: 100%;
      border: 0;
      border-radius: 0;
      background: var(--panel-2);
      padding: 13px 16px;
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 12px;
      align-items: center;
      text-align: left;
    }

    .section-header:hover { background: var(--panel-3); }
    .section-count { color: var(--muted); font-size: 12px; }
    .chev { color: var(--muted); }
    .section.collapsed .chev { transform: rotate(-90deg); }
    .section.collapsed .items { display: none; }

    .item {
      border-top: 1px solid var(--line);
      padding: 14px 16px;
    }

    .item.hidden { display: none; }
    .item-main {
      display: grid;
      grid-template-columns: minmax(240px, 1fr) minmax(280px, 0.92fr);
      gap: 16px;
    }

    .item-title {
      margin: 0 0 6px;
      font-weight: 800;
      color: var(--ink);
    }

    .route,
    .expected,
    .evidence {
      color: var(--muted);
      margin: 6px 0;
    }

    .route b,
    .expected b,
    .evidence b {
      color: var(--ink);
      font-weight: 750;
    }

    .steps {
      margin: 8px 0 0 20px;
      padding: 0;
    }

    .steps li { margin: 4px 0; }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 8px;
    }

    .tag {
      color: var(--muted);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 2px 7px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.035em;
    }

    .controls {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel-2);
      padding: 10px;
    }

    .status-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-bottom: 8px;
    }

    .status {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      color: var(--muted);
      cursor: pointer;
      user-select: none;
      font-size: 12px;
      font-weight: 800;
    }

    .status input { position: absolute; opacity: 0; pointer-events: none; }
    .status.active { color: white; }
    .status.pass.active { background: var(--pass); border-color: var(--pass); }
    .status.fail.active { background: var(--fail); border-color: var(--fail); }
    .status.blocked.active { background: var(--blocked); border-color: var(--blocked); }
    .status.retest.active { background: var(--retest); border-color: var(--retest); }
    .status.na.active { background: var(--na); border-color: var(--na); }
    .status.progress.active { background: var(--progress); border-color: var(--progress); }

    textarea,
    .meta-input {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--panel);
      color: var(--ink);
      padding: 8px;
      font: inherit;
      resize: vertical;
    }

    textarea { min-height: 86px; }
    .meta-input { min-height: 36px; margin-bottom: 8px; }

    .field-label {
      display: block;
      margin: 8px 0 4px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
    }

    .export-modal {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(23, 32, 42, 0.58);
      z-index: 20;
      padding: 20px;
    }

    .export-modal.open { display: flex; }
    .dialog {
      width: min(520px, 100%);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
    }

    .dialog h2 { margin: 0 0 12px; }
    .dialog label { display: block; margin: 9px 0; color: var(--ink); }

    footer {
      margin-top: 16px;
      color: var(--muted);
      font-size: 13px;
    }

    @media (max-width: 860px) {
      header,
      .toolbar,
      .item-main {
        grid-template-columns: 1fr;
      }

      .header-actions,
      .toolbar-actions {
        justify-content: flex-start;
      }

      .toolbar { top: 126px; }
      .stats { grid-template-columns: repeat(2, minmax(120px, 1fr)); }
      .status-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>YOW Owner Launch Checklist</h1>
      <div class="subtitle">Evidence-style tracker for the decisions, credentials, manual checks, and launch assets required from the owner before development can continue safely and YOW can launch.</div>
    </div>
    <div class="header-actions">
      <button type="button" onclick="expandAll()">Expand All</button>
      <button type="button" onclick="collapseAll()">Collapse All</button>
      <button type="button" class="primary" onclick="openExport()">Export Evidence</button>
      <button type="button" class="danger" onclick="resetAll()">Reset</button>
    </div>
  </header>

  <main class="wrap">
    <div class="toolbar">
      <input id="search" class="search" type="search" placeholder="Search owner tasks, routes, notes, evidence..." oninput="applyFilters()">
      <div class="toolbar-actions">
        <div class="filters">
          <button type="button" id="filter-all" class="filter active" onclick="setFilter('all')">All</button>
          <button type="button" id="filter-open" class="filter" onclick="setFilter('open')">Open</button>
          <button type="button" id="filter-progress" class="filter" onclick="setFilter('progress')">In Progress</button>
          <button type="button" id="filter-fail" class="filter" onclick="setFilter('fail')">Failed</button>
          <button type="button" id="filter-blocked" class="filter" onclick="setFilter('blocked')">Blocked</button>
          <button type="button" id="filter-retest" class="filter" onclick="setFilter('retest')">Retest</button>
          <button type="button" id="filter-notes" class="filter" onclick="setFilter('notes')">Has Notes</button>
        </div>
      </div>
    </div>

    <section class="stats" aria-label="Progress summary">
      <div class="stat"><strong id="stat-pass">0</strong><span>Passed</span></div>
      <div class="stat"><strong id="stat-open">0</strong><span>Open</span></div>
      <div class="stat"><strong id="stat-progress">0</strong><span>In progress</span></div>
      <div class="stat"><strong id="stat-fail">0</strong><span>Failed</span></div>
      <div class="stat"><strong id="stat-blocked">0</strong><span>Blocked</span></div>
      <div class="stat"><strong id="stat-complete">0%</strong><span>Owner readiness</span></div>
    </section>

    <section class="intro">
      <h2>How To Use This</h2>
      <p>This checklist tracks only work that needs owner action, owner judgement, credentials, or live manual evidence. Agent implementation tasks remain in <a href="ROADMAP.md">docs/ROADMAP.md</a> and deferred QA detail remains in <a href="QA_PLAN.md">docs/QA_PLAN.md</a>.</p>
      <ol>
        <li>Use <b>In Progress</b> while you are gathering credentials, evidence, or decisions.</li>
        <li>Use <b>Blocked</b> when you cannot continue without an outside action such as Stripe, Vercel, Supabase, app-store/signing, or legal review.</li>
        <li>Use <b>Retest</b> after a fix or configuration change, then run the full route again before marking Pass.</li>
        <li>Add concrete notes and artifact links: account aliases, project names, export filenames, screenshots, dashboard observations, and exact dates.</li>
        <li>Export evidence at the end of each owner QA session and attach it back to the roadmap/QA record.</li>
      </ol>
    </section>

    <div id="sections"></div>

    <footer>
      Source of truth: <a href="ROADMAP.md">docs/ROADMAP.md</a>, <a href="QA_PLAN.md">docs/QA_PLAN.md</a>, <a href="QA_CHECKLIST.md">docs/QA_CHECKLIST.md</a>, and <a href="../BILLING.md">BILLING.md</a>. This owner checklist is a working tracker, not a replacement roadmap.
    </footer>
  </main>

  <div id="exportModal" class="export-modal" role="dialog" aria-modal="true" aria-labelledby="exportTitle">
    <div class="dialog">
      <h2 id="exportTitle">Export Evidence</h2>
      <label><input type="radio" name="format" value="markdown" checked> Markdown report</label>
      <label><input type="radio" name="format" value="html"> HTML report</label>
      <label><input type="radio" name="format" value="json"> JSON data</label>
      <label><input type="radio" name="format" value="csv"> CSV spreadsheet</label>
      <label><input id="exportAll" type="checkbox" checked> Include open items without notes</label>
      <div class="header-actions" style="margin-top:16px;">
        <button type="button" onclick="closeExport()">Cancel</button>
        <button type="button" class="primary" onclick="runExport()">Download</button>
      </div>
    </div>
  </div>

  <script>
    const STORE_KEY = 'yow-owner-launch-checklist-v2';
    const COLLAPSE_KEY = 'yow-owner-launch-checklist-collapsed-v2';
    const STATUSES = ['progress', 'pass', 'fail', 'blocked', 'retest', 'na'];
    const STATUS_LABELS = {
      progress: 'In Progress',
      pass: 'Pass',
      fail: 'Fail',
      blocked: 'Blocked',
      retest: 'Retest',
      na: 'N/A'
    };

    const SECTIONS = [
      {
        id: 'unblock',
        title: '0. Immediate Development Unblockers',
        items: [
          item('paid-plan-decision', 'Decide how paid plans come back online', 'Pricing and Account Settings paid-plan CTAs', [
            'Choose whether to remove the temporary beta-interest flow, keep manual beta access temporarily, or migrate beta testers before real checkout returns.',
            'Record whether paid checkout remains disabled while this decision is open.',
            'Confirm what the next development slice should implement once the decision is made.'
          ], 'The product has one explicit owner-approved path for moving from beta-interest to real paid checkout.', 'Decision, date, current checkout state, and any migration notes.', ['decision', 'payment', 'blocker']),
          item('stripe-price-alignment', 'Update Stripe prices to match the live site', 'Stripe Dashboard and Vercel production env', [
            'Confirm the site-displayed prices: Monthly £10, Lifetime £150, Founder £300, hosting renewal £6/year.',
            'Create or update Stripe Price objects so real checkout charges those exact amounts.',
            'Point the production `STRIPE_PRICE_ID_*` variables at the correct live Price IDs.',
            'Redeploy/refresh the production functions that read those env vars.'
          ], 'No user can be charged an old price while the site displays a new one.', 'Stripe Price IDs, Vercel env screenshot/check, deployment timestamp.', ['stripe', 'payment', 'blocker']),
          item('production-env-check', 'Confirm production environment variables', 'Vercel, Supabase, Stripe, email provider', [
            'Verify production has current Supabase URL/anon/service-role values, Stripe secret/price/webhook values, `SITE_URL`, feedback email credentials, and AI settings encryption secrets.',
            'Confirm no secret is placed in a client-exposed `VITE_` variable unless it is intended to be public.',
            'Record the deployment/redeploy needed after any env change.'
          ], 'Production configuration is complete enough for payment, interest form, auth, AI settings sync, and support email routes.', 'Environment checklist, deployment ID, and any redacted screenshots.', ['credentials', 'vercel', 'supabase']),
          item('test-account-matrix', 'Create the live QA account matrix', 'Production YOW accounts', [
            'Create or identify Account A, Account B, a fresh new account, a Free account, Monthly-like account, Lifetime-like account, Founder-like account, beta_tester account, and desktop-entitled account where available.',
            'Do not use the owner/admin account for destructive tests.',
            'Record account aliases, entitlement state, AI sync state, and baseline project names.'
          ], 'Manual QA can be run without risking real owner data or mixing account states.', 'Account matrix, entitlement notes, baseline screenshots.', ['qa', 'accounts', 'blocker']),
          item('launch-scope-confirm', 'Confirm the final launch promise for all 6 active project types', 'Roadmap Launch Required / Project Type Launch Scope', [
            'Confirm Novel, Novella, Short Story, D&D Campaign, TTRPG Campaign, and Comic/Graphic Novel remain final launch scope.',
            'If any type should not block final launch, explicitly move it to Future/Excluded in the roadmap by product decision.',
            'Confirm beta/limited labels are allowed only during public beta, not final paid launch.'
          ], 'Engineering knows whether to finish all 6 active workflows or reduce the launch promise intentionally.', 'Owner scope decision and any roadmap update reference.', ['scope', 'decision', 'project-types'])
        ]
      },
      {
        id: 'data-safety',
        title: '1. Data Safety Evidence You Need To Run Or Witness',
        items: [
          item('data-safety-export', 'Run the dedicated data-safety checklist and export evidence', 'docs/data-safety-qa-checklist.html', [
            'Run the data-safety checklist in a real browser against the intended environment.',
            'Include auth isolation, autosave, stale writes, backup/restore, destructive actions, media/quota, desktop vault if in scope, cloud expiry, and failure injection.',
            'Export Markdown or HTML evidence at the end of the session.'
          ], 'The Data Safety gate has a dated evidence artifact rather than relying on memory or code inspection.', 'Export filename, date, account aliases, environment, and any failed item IDs.', ['qa', 'data-safety', 'blocker']),
          item('same-scene-conflict-final', 'Witness the final same-scene multi-tab conflict route', 'Two tabs, same account/project/scene, deployed build', [
            'Open the same scene in two tabs and verify the “Also open in another tab” warning appears when expected.',
            'Edit in both tabs, wait for the real Saved state, refresh both tabs, and confirm both agree.',
            'Log out and back in, confirm neither edit is lost, and confirm conflict-copy review survives refresh.',
            'Use Restore/Discard only after exporting or screenshotting the conflict evidence.'
          ], 'The recently recurring same-scene data-loss class cannot pass without the exact warning, refresh, relogin, and conflict-copy survival proof.', 'Browser, account, project, scene, warning screenshot, conflict resolution result.', ['qa', 'conflict', 'blocker']),
          item('structured-conflict-final', 'Witness structured-record conflict coverage', 'Two tabs, same account, deployed build', [
            'Edit different records in two tabs and confirm both survive.',
            'Edit different fields on the same record in two tabs and confirm both survive where field-level merge applies.',
            'Edit the same field concurrently and confirm a visible sync-conflict banner appears.',
            'Use Restore/Keep mine controls and verify refresh/export behavior afterward.'
          ], 'Structured record QA no longer relies on vague last-write-wins acceptance for valuable user content.', 'Record types, fields edited, final values, banner/control screenshots.', ['qa', 'conflict', 'worldbuilding']),
          item('account-switch-real-auth', 'Real-auth account switch test', 'Same browser, two real Supabase accounts', [
            'Sign into Account A and open a project containing A-only sentinel records.',
            'Sign out, then sign into Account B without clearing browser storage or restarting.',
            'Search B for A sentinel names and create/edit B-only records.',
            'Refresh, sign out, return to A, and confirm A data is intact.'
          ], 'Account B never sees or overwrites Account A data, AI keys, profile settings, or storage state.', 'A/B project counts, search terms, screenshots, any local storage observations.', ['qa', 'auth', 'blocker']),
          item('ai-key-isolation-sync', 'AI key isolation and sync test', 'Account Settings -> AI, all AI surfaces', [
            'Configure Account A provider/key and optional synced AI settings.',
            'Verify Account Settings, AI Assistant, AI Chat, AI Import, manuscript suggestions, Ideas AI expand, AI Tools, and Character Chat can use A settings.',
            'Sign into Account B in the same browser and a fresh profile and confirm B sees no A key/settings.',
            'Disable A sync, remove A key, and confirm fresh profiles/devices no longer receive it.'
          ], 'AI credentials remain masked, owner-scoped, removable, and never hydrate into a different account.', 'Accounts, surfaces checked, sync state, key removal result.', ['qa', 'ai', 'security']),
          item('media-storage-live', 'Live signed-in media upload and quota test', 'Supabase Storage user-media bucket', [
            'Upload, refresh, sign out/in, and open from a second profile for every major image surface.',
            'Replace and delete media, then confirm old object cleanup and storage-used decrement.',
            'Confirm owner-scoped write/delete RLS with Account B.',
            'Confirm no localStorage-full warning is triggered by inline base64 growth.'
          ], 'Production media storage behaves like owned user data, not disposable local cache.', 'Object paths, usage before/after, account IDs, screenshots.', ['qa', 'storage', 'media']),
          item('storage-full-route', 'Storage-full route fails loudly and recoverably', 'Production or controlled test profile', [
            'Trigger the storage-exceeded route through the supported test hook or a safe quota scenario.',
            'Attempt text edits, media upload, and structured-record creation.',
            'Verify warnings are sticky/clear, forms keep unsaved user input, and freeing space allows retry.',
            'Confirm the current Free 250 MB and Monthly 8 GB quota expectations are used, not old caps.'
          ], 'Quota failures never look like successful saves and never discard the user input needed to recover.', 'Method, plan state, warning copy, preserved input, retry result.', ['qa', 'quota', 'blocker'])
        ]
      },
      {
        id: 'exports',
        title: '2. Export Ownership And Restore Review',
        items: [
          item('zip-backup-review', 'Review ZIP backup completeness for every active project type', 'Backup ZIP export and restore', [
            'Create sentinel data in manuscript/session/page-panel content, worldbuilding, map, schedule, factions, character builder, project settings, AI chats, and type-specific records where applicable.',
            'Export ZIP, inspect the archive for sentinel strings and expected JSON files, then restore as a new project.',
            'Confirm restored project type, structure, counts, ordering, images, settings, and type-specific data.',
            'Delete the restored copy and confirm cleanup.'
          ], 'Every active project type can be reconstructed from backup without mutating unrelated projects.', 'Per-type results, ZIP filenames, restored project names, missing data notes.', ['export', 'restore', 'blocker']),
          item('readable-docx-bundle-review', 'Review the promised readable DOCX bundle', 'Readable Word export ZIP', [
            'Generate the readable Word export bundle for realistic projects.',
            'Confirm it contains separate category Word files for Overview, Outline/Campaign Sessions/Comic Script, Manuscript/Session Drafts, Schedule, Characters, Locations, Factions, Lore, Notes, Timeline, World History, and AI Chats when present.',
            'Search for sentinel content and confirm conflict/internal/deleted records do not appear as normal live content.',
            'Treat World Bible PDF/HTML as secondary/styled export evidence, not the primary promised readable worldbuilding export.'
          ], 'The user can recover meaningful creative work from readable Word files even if app restore is unavailable.', 'Bundle filename, category files present, missing sections, World Bible note if checked.', ['export', 'ownership']),
          item('import-existing-account', 'Restore into an account with existing projects', 'Import ZIP into populated account', [
            'Record the existing project list and counts before import.',
            'Import a ZIP from another project/account if permitted.',
            'Confirm a new independent project appears rather than overwriting an existing one.',
            'Open unrelated projects and verify sentinel records remain untouched.'
          ], 'Import cannot damage or silently replace unrelated user data.', 'Before/after project list, affected IDs, restore result.', ['export', 'restore', 'isolation']),
          item('bad-import-safe', 'Corrupt or wrong-format imports fail safely', 'Import ZIP / third-party archive route', [
            'Try a truncated ZIP, a non-YOW ZIP, a renamed text file, and an oversized archive where practical.',
            'Observe error handling and the project list afterward.',
            'Refresh and confirm no partial project polluted the library unless clearly labelled as recoverable.',
            'Confirm existing data remains unchanged.'
          ], 'Bad imports never damage existing projects and provide a clear error or safe partial-recovery state.', 'Files tested, errors shown, project count before/after.', ['export', 'error'])
        ]
      },
      {
        id: 'payment',
        title: '3. Payments, Plans, And Entitlements',
        items: [
          item('beta-interest-flow', 'QA the temporary beta-interest flow', 'Production Pricing and Account Settings CTAs', [
            'Signed in as Free, click each paid-plan CTA and submit the interest form.',
            'Confirm the admin inbox receives plan/user details.',
            'Confirm Supabase auth metadata becomes `subscription_plan: beta_tester` only for signed-in submissions.',
            'Refresh and confirm unlimited projects, AI tools, desktop entitlement label, and Beta Tester membership state.',
            'Submit signed out and confirm it emails interest without claiming account access.'
          ], 'Temporary access grants are intentional, traceable, and cannot accidentally grant an account from signed-out interest.', 'Inbox evidence, account metadata, plan label, signed-out result.', ['payment', 'beta', 'qa']),
          item('checkout-monthly', 'Run Monthly checkout QA at £10', 'Stripe Checkout and Billing Portal', [
            'Complete checkout using the owner-approved live or test-mode route.',
            'Verify Stripe session/subscription, webhook delivery, Supabase metadata, and app access.',
            'Open customer portal, cancel where safe, and verify expiry/cancel behavior.',
            'Confirm checkout cannot charge the old £12 amount.'
          ], 'Monthly users are charged the displayed £10 price and receive the correct entitlement only after webhook-confirmed metadata.', 'Stripe session, webhook result, account metadata, portal result.', ['payment', 'stripe', 'blocker']),
          item('checkout-lifetime', 'Run Lifetime checkout QA at £150', 'Stripe Checkout and YOW entitlement state', [
            'Complete checkout using the owner-approved live or test-mode route.',
